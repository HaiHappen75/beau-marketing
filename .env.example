# ─────────────────────────────────────────────────────────────────────────────
# Beau-Marketing — Environment
# Copy to `.env` for local dev. In production set these in Coolify.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string.
#   LOCAL: matches docker-compose.yml below
#   PROD:  Coolify Postgres resource (internal service hostname, port 5432)
DATABASE_URI=postgres://beau:beau@localhost:5432/beau_marketing

# Long random secret used to sign JWTs. Generate: `openssl rand -base64 32`
# Rotating this invalidates all admin sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public base URL — baked into the client bundle at BUILD time.
#   LOCAL: http://localhost:3000
#   PROD:  https://beau-marketing.de   (set as BUILD + runtime variable in Coolify)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Runtime heap cap for the production container (8 GB server). Not needed locally.
# NODE_OPTIONS=--max-old-space-size=1024

# ── SMTP (Mittwald) ──────────────────────────────────────────────────────────
# Only needed so the admin's "forgot password" mail actually gets delivered.
# Leave SMTP_HOST empty locally: Payload then logs the mail instead of sending it.
# Credentials come from the Mittwald mStudio mailbox (E-Mail → Postfach → Zugangsdaten).
# Port 587 = STARTTLS (recommended), 465 = implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@beau-marketing.de
SMTP_FROM_NAME=Beau-Marketing

# ── eRecht24 (Impressum + Datenschutzerklärung) ──────────────────────────────
# Neither value is self-generated: the API key comes from the eRecht24 Project
# Manager, the push secret is issued by eRecht24 when the push client is
# registered (`npx erecht24-register <url>`) and shown exactly once.
#
# ERECHT24_API_KEY must be set as BUILD + runtime variable in Coolify — the
# build refreshes content/legal/*.json. Missing key = committed snapshot is
# used, the build still succeeds.
ERECHT24_API_KEY=
# Shared secret of the push webhook (/api/erecht24/push). Runtime only.
ERECHT24_PUSH_SECRET=
